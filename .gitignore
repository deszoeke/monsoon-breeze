# Local run directory for model output and checkpoints (monsoon_job.sh default)
/run/
*.nc
*.jld2

# Machine-specific precompile request (setup_precompile.jl --arch=gpu writes it per machine)
LocalPreferences.toml

# The top-level Manifest.toml is tracked: it pins package versions for laptop and HPC.
# A manifest inside the local package would be ignored by the environment anyway.
MonsoonConvection/Manifest.toml

# Julia coverage / allocation files
*.jl.cov
*.jl.*.cov
*.jl.mem

# Plots and movies from analysis scripts
*.png
*.mp4

# Batch-job logs
slurm-*.out
*.log

# OS and editor files
.DS_Store
.vscode/
.idea/
*.swp
*~
