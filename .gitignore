# Local run directory for model output and checkpoints (monsoon_job.sh default)
/run/
*.nc
*.jld2

# Machine-specific precompile request (setup_precompile.jl --arch=gpu writes it per machine)
LocalPreferences.toml*

# Manifests are not tracked: each machine (laptop, HPC) resolves its own from the compat bounds in
# MonsoonConvection/Project.toml, so a pull never replaces another machine's manifest or forces a
# recompile. Upgrade packages by changing those bounds, then Pkg.update on each machine.
Manifest.toml
MonsoonConvection/Manifest.toml

# Julia coverage / allocation files
*.jl.cov
*.jl.*.cov
*.jl.mem

# Plots and movies from analysis scripts
*.png
*.mp4

# Batch-job logs
slurm-*.out
*.log

# OS and editor files
.DS_Store
.vscode/
.idea/
*.swp
*~

# graphify
graphify-out/graph.html
graphify-out/.graphify_*
graphify-out/manifest.json
graphify-out/cache/

graphify-out/
graphify-*/
